				"definition": {
					"factory": "output",
					"type": "drum-kit",
					"options": {
						"volume": 0.7,
						"channel": 10,
						"receiveChannels": [10]
					}
				}
			},
			{
				"id": "remote-echo",
				"direction": "output",
				"definition": {
					"factory": "output",
					"type": "protocol",
					"options": {
						"mode": "audiobus",
						"url": "",
						"sendToConnectedApplications": true

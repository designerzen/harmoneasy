				"transformers": "[\"{\\\"type\\\":\\\"Harmoniser\\\",\\\"midiControlId\\\":\\\"remote-harmoniser\\\",\\\"enabled\\\":true,\\\"root\\\":0,\\\"mode\\\":[0,2,4,5,7,9,11]}\",\"{\\\"type\\\":\\\"Chordifier\\\",\\\"midiControlId\\\":\\\"remote-chordifier\\\",\\\"enabled\\\":false,\\\"root\\\":3,\\\"mode\\\":\\\"ionian\\\",\\\"simultaneous\\\":3}\"]",
				"inputs": [

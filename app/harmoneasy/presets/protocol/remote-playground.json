{
	"format": "harmoneasy-preset",
	"version": 1,
	"name": "audioBus Protocol — Remote control playground",
	"description": "Made to be played and changed from another application. Notes on channel 10 play drums; every other channel plays a lead synth through a Harmoniser and a Chordifier, which start in C major with chords off. Every control on the surface can be pressed, switched or set remotely, the transport and tempo can be changed, and other presets can be loaded. The audioBus Protocol output sends the lead's notes back to every connected window. Try it with the remote control demo at protocol-remote.html.",
	"clock": {
		"bpm": 120,
		"swing": 0,
		"divisions": 24,
		"bars": 4
	},
	"midiControls": {
		"enabled": true,
		"bindings": []
	},
	"workspace": {

{
	"name": "harmoneasy",
	"private": true,
	"version": "0.19.1",
	"description": "MIDI/audio application with Electron desktop support",
	"license": "AGPL-3.0-or-later",
	"author": "designerzen <radio@awesomething.co.uk>",
	"homepage": "https://github.com/designerzen/harmoneasy",
	"type": "module",
	"start": "./source/index.ts",
	"main": "electron/electron-main.js",
	"scripts": {
		"install": "node -e \"console.log('Native MIDI addon is built explicitly with pnpm run build-native or pnpm run build:electron')\"",
		"setup": "pnpm install --allow-build=electron",
		"install:electron": "pnpm approve-builds && npm run build-native",
		"test": "vitest --config vite.config.web.js",
		"presets:validate": "vitest run --config vite.config.web.js tests/preset-files.test.ts tests/builtin-preset-pages.test.ts",
		"osc:bridge": "node scripts/osc-bridge.cjs",
		"harmony:bridge": "node scripts/harmony-bridge.cjs",
		"type-check": "tsc --noEmit",
		"dev": "node scripts/update-packages-config.js && vite --config vite.config.web.js",
		"dev:electron": "node scripts/update-packages-config.js && concurrently \"npm run dev\" \"wait-on http://localhost:1999 && electron .\"",
		"start": "pnpm run dev",
		"build": "node scripts/update-packages-config.js && vite build --config vite.config.web.js",
		"build-native": "pnpm exec node-gyp rebuild",
		"build-native:clean": "pnpm exec node-gyp clean && pnpm exec node-gyp configure && pnpm exec node-gyp build",
		"copy-native": "node ../../scripts/copy-native-modules.js",
		"build-vite-electron": "vite build --config vite.config.electron.js",
		"build:electron": "node scripts/update-packages-config.js && pnpm run build-native && pnpm run build-vite-electron && pnpm run copy-native && electron-builder",
		"preview": "vite preview",
		"electron": "electron .",
		"versions": "node scripts/update-packages-config.js",
		"upgrader": "npx npm-check-updates --interactive -u",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"test:core": "vitest run --config vite.config.web.js --maxWorkers 2 --testTimeout 20000 tests/about-dialog.test.ts tests/start-contexts.test.ts tests/state-location.test.ts tests/clock-source.test.ts tests/preset-browser.test.ts tests/engineering-fixes.test.ts tests/classroom-session.test.ts tests/theme.test.ts tests/accessibility-focus-stage.test.ts tests/adaptive-input-timing.test.ts tests/access-profile-calibration.test.ts tests/setup-wizard.test.ts",
		"lint:ci": "pnpm -w exec oxlint app/harmoneasy/",
		"ci:check": "pnpm run lint:ci && pnpm run type-check && pnpm run presets:validate --maxWorkers 2 && pnpm run test:core"
	},
	"devDependencies": {
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/web-bluetooth": "^0.0.21",
		"concurrently": "^9.2.5",
		"electron": "^41.10.7",
		"electron-builder": "^26.8.1",
		"happy-dom": "^20.14.5",
		"node-addon-api": "^8.9.2",
		"node-gyp": "^12.4.0",
		"partykit": "0.0.115",
		"sass-embedded": "^1.108.2",
		"typescript": "~5.9.3",
		"update-electron-app": "^3.3.0",
		"vite": "^8.0.1",
		"vitest": "^4.1.12",
		"wait-on": "^9.5.1",
		"ws": "^8.23.0"
	},
	"dependencies": {
		"@harmoneasy/shared-config": "workspace:^",
		"@huggingface/transformers": "3.8.1",
		"@xyflow/react": "^12.12.1",
		"audiobus": "workspace:^",
		"audiobus-output-opendaw-vaporisateur": "workspace:^",
		"audiobus-output-pink-trombone": "workspace:^",
		"audiobus-output-voice-workshop": "workspace:^",
		"audiotool": "workspace:^",
		"control-surface": "workspace:^",
		"entitree-flex": "^0.4.1",
		"flodjs": "workspace:^",
		"jzz": "^1.9.6",
		"lz-string": "^1.5.0",
		"midi-ble": "workspace:^",
		"netronome": "workspace:^",
		"opendaw": "workspace:^",
		"partysocket": "1.1.16",
		"pitfalls": "workspace:^",
		"qrcode": "^1.5.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"uWebSockets.js": "github:uNetworking/uWebSockets.js",
		"webrtc-adapter": "^9.0.6"
	},
	"build": {
		"appId": "com.harmoneasy.app",
		"productName": "Harmoneasy",
		"directories": {
			"buildResources": "public",
			"output": "dist-electron"
		},
		"extraMetadata": {
			"main": "electron/electron-main.js"
		},
		"files": [
			"dist-electron/**/*",
			"public/**/*",
			"build/Release/**/*.node",
			"electron/**/*",
			"node_modules/**/*",
			"package.json"
		],
		"icon": "public/icon.png",
		"win": {
			"target": [
				"nsis",
				"portable"
			],
			"icon": "public/icon.png"
		},
		"mac": {
			"target": [
				"dmg",
				"zip"
			],
			"icon": "public/icon.png",
			"category": "public.app-category.music"
		},
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"icon": "public/icon.png",
			"category": "Audio"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		},
		"publish": {
			"provider": "github",
			"owner": "designerzen",
			"repo": "harmoneasy"
		}
	}
}

{
	"name": "harmoneasy",
	"private": true,
	"type": "module",
	"version": "0.16.1",
	"description": "A web-based music collaboration platform that transforms, quantizes, and harmonizes live MIDI input in real-time",
	"author": "designerzen <radio@awesomething.co.uk>",
	"packageManager": "pnpm@12.0.0",
	"scripts": {
		"postinstall": "git submodule update --remote --init",
		"upgrade:git": "git submodule update --remote",
		"upgrade:turbo": "turbo run upgrader",
		"start": "pnpm run dev --filter=harmoneasy",
		"turbo": "turbo",
		"dev": "turbo run dev",
		"build:netronome": "pnpm --filter netronome run build",
		"build": "pnpm -r --no-bail --if-present run build",
		"build:electron": "pnpm --filter ./app/harmoneasy run build:electron",
		"test": "pnpm -r --no-bail --if-present run test --run --maxWorkers 4",
		"type-check": "pnpm -r --if-present run type-check",
		"upgrader": "pnpm run upgrade:git && pnpm run upgrade:turbo",
		"preview": "turbo run preview",
		"clean": "turbo clean && rm -rf .turbo node_modules",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"check": "pnpm run fmt:check && pnpm run lint"
	},
	"devDependencies": {
		"@types/node": "^22.10.5",
		"oxfmt": "^0.41.0",
		"oxlint": "^1.90.0",
		"turbo": "^2.8.14",
		"typescript": "~5.9.3",
		"vitest": "^4.1.11"
	}
}